{
  "name": "luna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/studio"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "luna": "./dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "studio:dev": "npm run dev --workspace studio",
    "studio:build": "npm run build --workspace studio",
    "studio:e2e": "npm run build && npm run studio:build && playwright test --config tests/studio/e2e/playwright.config.ts",
    "studio:e2e:ui": "npm run build && npm run studio:build && playwright test --ui --config tests/studio/e2e/playwright.config.ts",
    "studio:lint": "npm run lint --workspace studio",
    "studio:test": "npm run test --workspace studio",
    "build": "tsc -p tsconfig.json",
    "lint:unused": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:unused-src": "tsc -p tsconfig.unused-src.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@fastify/static": "^9.3.0",
    "@langchain/langgraph": "^1.4.7",
    "@vue/compiler-sfc": "^3.5.39",
    "bullmq": "^5.79.2",
    "fastify": "^5.9.0",
    "ioredis": "^5.11.1",
    "jsonata": "^2.2.1",
    "pi-imagegen": "0.2.0",
    "twitter-text": "3.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "overrides": {
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@0.80.6",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@0.80.6",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@0.80.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.33",
    "@types/twitter-text": "3.1.10",
    "knip": "^6.17.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
