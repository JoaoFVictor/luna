{
  "name": "luna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "luna": "./dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "lint:unused": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:unused-src": "tsc -p tsconfig.unused-src.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.9",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@vue/compiler-sfc": "^3.5.39",
    "bullmq": "^5.79.2",
    "fastify": "^5.9.0",
    "ioredis": "^5.11.1",
    "jsonata": "^2.2.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.33",
    "knip": "^6.17.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
