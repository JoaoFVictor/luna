{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "image_prompt", "strategy", "character_count", "claims_to_verify"],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "image_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "character_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 280
    },
    "claims_to_verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
