{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "focus_areas", "files_to_review"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files_to_review": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
