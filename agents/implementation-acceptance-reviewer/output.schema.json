{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "blocking_reasons"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["accepted", "rejected", "needs_human_review"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
