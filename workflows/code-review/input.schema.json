{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "owner",
    "repo",
    "pull_number",
    "base_ref",
    "base_repository",
    "head_repository",
    "references"
  ],
  "properties": {
    "target": {
      "type": "string",
      "const": "github_pr"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "pull_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "base_repository": {
      "$ref": "#/definitions/repository"
    },
    "head_repository": {
      "$ref": "#/definitions/head_repository"
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha"],
      "properties": {
        "base_sha": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "full_name"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "head_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name", "full_name"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "fork": {
          "type": "boolean"
        }
      }
    }
  }
}
