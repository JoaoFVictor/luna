{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "run", "report"],
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "run": {
          "$ref": "#/definitions/run_identity"
        },
        "report": {
          "$ref": "#/definitions/final_report"
        },
        "workspace": {
          "$ref": "#/definitions/workspace"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "run", "error"],
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "run": {
          "$ref": "#/definitions/run_identity"
        },
        "error": {
          "$ref": "#/definitions/error_artifact"
        },
        "workspace": {
          "$ref": "#/definitions/workspace"
        }
      }
    }
  ],
  "definitions": {
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "attempt", "source", "event"],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "route_target": {
          "$ref": "#/definitions/route_target"
        },
        "subject": {
          "$ref": "#/definitions/run_subject"
        }
      }
    },
    "route_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "workflow"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "final_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_path", "acceptance", "findings"],
      "properties": {
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "$ref": "#/definitions/acceptance"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/finding"
          }
        },
        "workspace": {
          "$ref": "#/definitions/workspace"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "blocking_reasons", "recommended_action"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["accepted", "rejected", "needs_human_review"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "approve",
            "comment",
            "request_changes",
            "continue",
            "stop",
            "human_review"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity",
        "confidence",
        "description",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "path", "preserved", "reason"],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "preserved": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
