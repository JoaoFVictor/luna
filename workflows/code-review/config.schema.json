{
  "type": "object",
  "additionalProperties": false,
  "required": ["code_review"],
  "properties": {
    "code_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_request_review"],
      "properties": {
        "review_dimensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "x-luna-studio": { "exposure": "editable" }
        },
        "related_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_related_files": {
              "type": "integer",
              "minimum": 1,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_scan_files": {
              "type": "integer",
              "minimum": 1,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_file_bytes": {
              "type": "integer",
              "minimum": 1,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_excerpt_bytes": {
              "type": "integer",
              "minimum": 1,
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_tests": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_docs": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_configs": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            }
          }
        },
        "pull_request_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider", "event", "inline_comments"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "x-luna-studio": { "exposure": "read_only" }
            },
            "event": {
              "enum": ["auto", "comment", "request_changes", "approve"],
              "x-luna-studio": { "exposure": "editable" }
            },
            "inline_comments": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "comment_policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inline_evidence": {
                  "enum": ["primary", "all"],
                  "x-luna-studio": { "exposure": "editable" }
                },
                "max_inline_comments": {
                  "type": "integer",
                  "minimum": 1,
                  "x-luna-studio": { "exposure": "editable" }
                }
              }
            }
          }
        }
      }
    }
  }
}
