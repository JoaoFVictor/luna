{
  "type": "object",
  "additionalProperties": false,
  "required": ["implementation"],
  "properties": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_pattern",
        "commit",
        "push",
        "change_request",
        "sandbox",
        "validation",
        "repository_context"
      ],
      "properties": {
        "branch_pattern": {
          "type": "string",
          "minLength": 1,
          "x-luna-studio": { "exposure": "editable" }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "remote"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "remote": {
              "type": "string",
              "minLength": 1,
              "x-luna-studio": { "exposure": "read_only" }
            }
          }
        },
        "change_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider", "draft", "base_ref"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "x-luna-studio": { "exposure": "read_only" }
            },
            "draft": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "base_ref": {
              "type": "string",
              "minLength": 1,
              "x-luna-studio": { "exposure": "editable" }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "trusted_host_local",
              "x-luna-studio": { "exposure": "read_only" }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repair_attempts", "max_output_bytes"],
          "properties": {
            "repair_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304,
              "x-luna-studio": { "exposure": "editable" }
            }
          }
        },
        "repository_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_related_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_seed_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "x-luna-studio": { "exposure": "editable" }
            },
            "max_excerpt_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384,
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_tests": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_docs": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            },
            "include_configs": {
              "type": "boolean",
              "x-luna-studio": { "exposure": "editable" }
            }
          }
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "commit": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "push": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "push": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": false }
                }
              },
              "change_request": {
                "required": ["enabled"],
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      ]
    }
  }
}
