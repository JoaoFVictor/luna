{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["json", "markdown"],
  "properties": {
    "json": {
      "$ref": "#/definitions/final_report"
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "final_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "repository",
        "status",
        "branch",
        "worktree",
        "validation",
        "commit",
        "push",
        "change_request",
        "warnings"
      ],
      "properties": {
        "task": {
          "$ref": "#/definitions/task_summary"
        },
        "jira": {
          "$ref": "#/definitions/jira_summary"
        },
        "plane": {
          "$ref": "#/definitions/plane_summary"
        },
        "repository": {
          "$ref": "#/definitions/repository"
        },
        "status": {
          "type": "string",
          "enum": ["validation_failed", "ready_for_change_request", "completed_with_skips"]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "worktree": {
          "$ref": "#/definitions/worktree_summary"
        },
        "validation": {
          "$ref": "#/definitions/validation_summary"
        },
        "commit": {
          "$ref": "#/definitions/commit_action"
        },
        "push": {
          "$ref": "#/definitions/push_action"
        },
        "change_request": {
          "$ref": "#/definitions/change_request_action"
        },
        "execution": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "required": ["jira"],
          "not": {
            "required": ["plane"],
            "properties": {
              "plane": {}
            }
          },
          "properties": {
            "jira": {
              "$ref": "#/definitions/jira_summary"
            },
            "task": {
              "type": "object",
              "properties": {
                "provider": {
                  "const": "jira"
                }
              }
            }
          }
        },
        {
          "required": ["plane"],
          "not": {
            "required": ["jira"],
            "properties": {
              "jira": {}
            }
          },
          "properties": {
            "plane": {
              "$ref": "#/definitions/plane_summary"
            },
            "task": {
              "type": "object",
              "properties": {
                "provider": {
                  "const": "plane"
                }
              }
            }
          }
        }
      ]
    },
    "task_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "key", "id", "url", "title", "status"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["jira", "plane"]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "jira_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "url", "summary", "status"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plane_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "workspace_slug", "priority", "labels"],
      "anyOf": [
        {
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["project_id"]
        },
        {
          "properties": {
            "project_identifier": {
              "type": "string",
              "minLength": 1
            },
            "issue_identifier": {
              "type": "integer"
            }
          },
          "required": ["project_identifier", "issue_identifier"]
        }
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer"
        },
        "workspace_slug": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_identifier": {
          "type": "string",
          "minLength": 1
        },
        "issue_identifier": {
          "type": "integer"
        },
        "priority": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "worktree_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "preserved", "reason"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "preserved": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "command_count"],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "command_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commit_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "skipped", "status"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "push_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "skipped", "status"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "change_request_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "skipped", "status"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "const": "github"
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
