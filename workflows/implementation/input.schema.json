{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "workflow", "jira", "repository"],
  "properties": {
    "target": {
      "type": "string",
      "const": "jira_task"
    },
    "workflow": {
      "type": "string",
      "const": "implementation"
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "issue_key",
        "url",
        "summary",
        "description",
        "acceptance_criteria",
        "status",
        "issue_type"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "issue_key": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "issue_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
