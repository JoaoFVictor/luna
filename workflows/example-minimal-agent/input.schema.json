{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "event",
    "repository",
    "subject",
    "references"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2026-06"
    },
    "source": {
      "type": "string",
      "const": "github"
    },
    "event": {
      "type": "string",
      "const": "pull_request"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/definitions/route_target"
    },
    "repository": {
      "$ref": "#/definitions/repository"
    },
    "subject": {
      "$ref": "#/definitions/pull_request_subject"
    },
    "actor": {
      "$ref": "#/definitions/actor"
    },
    "references": {
      "$ref": "#/definitions/references"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "route_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "workflow"
        },
        "id": {
          "type": "string",
          "const": "example-minimal-agent"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pull_request_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "pull_request"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_ref", "base_sha", "head_sha"],
      "properties": {
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
